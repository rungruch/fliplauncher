<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/coverWidgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/fl_background" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_mark"
            android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingStart="8dp" android:paddingEnd="0dp" android:text="@string/app_name" android:textColor="@android:color/white"
            android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
        <ImageButton android:id="@+id/editWidgetScreens" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_widget_add"
            android:contentDescription="@string/edit_widget_screens" />
    </LinearLayout>
    <LinearLayout android:id="@+id/dashboardShortcutStrip" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/coverWidgetPages" android:layout_width="match_parent"
            android:layout_height="match_parent" android:overScrollMode="never" />
        <TextView android:id="@+id/coverWidgetEmpty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="24dp" android:text="@string/cover_widgets_empty"
            android:textSize="15sp" android:textColor="@android:color/white" android:clickable="true" android:focusable="true" />
    </FrameLayout>
    <LinearLayout android:id="@+id/widgetPageNavigation" android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/previousWidgetPage" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_widget_previous"
            android:contentDescription="@string/previous_widget_page" />
        <TextView android:id="@+id/widgetPageCounter" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:textSize="13sp" android:textColor="@color/fl_gray_40" />
        <ImageButton android:id="@+id/nextWidgetPage" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_widget_next"
            android:contentDescription="@string/next_widget_page" />
    </LinearLayout>
</LinearLayout>
