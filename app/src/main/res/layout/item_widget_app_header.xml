<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp"
    android:layout_marginBottom="8dp" android:background="@drawable/fl_editor_card"
    android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
    android:accessibilityHeading="true">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/widgetAppLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/fl_editor_text" />
        <TextView android:id="@+id/widgetAppCount" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="@color/fl_editor_secondary" />
    </LinearLayout>
    <TextView android:id="@+id/widgetAppToggle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:textSize="14sp" android:textColor="@color/fl_primary"
        android:importantForAccessibility="no" />
</LinearLayout>
