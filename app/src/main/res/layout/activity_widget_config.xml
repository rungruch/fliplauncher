<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editorRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/fl_editor_background"
    android:focusable="true" android:focusableInTouchMode="true">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textSize="30sp" android:textStyle="bold"
                android:textColor="@color/fl_editor_text" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/editor_subtitle" android:textSize="15sp"
                android:textColor="@color/fl_editor_secondary" />
            <TextView android:id="@+id/setupHelp" android:layout_width="match_parent"
                android:layout_height="48dp" android:gravity="center_vertical" android:text="@string/add_cover_widget"
                android:textSize="14sp" android:textColor="@color/fl_primary"
                android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
            <Spinner android:id="@+id/profileSpinner" android:layout_width="match_parent"
                android:layout_height="48dp" android:background="@drawable/fl_editor_card" />
            <TextView android:id="@+id/profileHint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textSize="13sp" android:textColor="@color/fl_editor_secondary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/your_cover_apps" android:textSize="18sp" android:textStyle="bold"
                    android:textColor="@color/fl_editor_text" android:accessibilityHeading="true" />
                <TextView android:id="@+id/selectionCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/fl_editor_secondary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/previewSurface" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="8dp"
                android:orientation="vertical" android:background="@drawable/fl_preview_wallpaper">
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="0dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_widget_mark" android:importantForAccessibility="no" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:paddingStart="8dp" android:paddingEnd="0dp" android:text="@string/app_name"
                        android:textSize="16sp" android:textStyle="bold" android:textColor="@android:color/white" />
                    <ImageButton android:id="@+id/previewAdd" android:layout_width="48dp" android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp"
                        android:src="@drawable/ic_widget_add" android:contentDescription="@string/all_apps" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/selectedAppsGrid"
                    android:layout_width="match_parent" android:layout_height="160dp" android:overScrollMode="never" />
                <TextView android:id="@+id/previewEmpty" android:layout_width="match_parent" android:layout_height="120dp"
                    android:gravity="center" android:padding="24dp" android:text="@string/preview_empty"
                    android:textColor="@android:color/white" android:textSize="14sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/reorder_hint" android:textSize="12sp"
                android:textColor="@color/fl_editor_secondary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:orientation="vertical" android:padding="16dp"
                android:background="@drawable/fl_editor_card">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/wallpaperSwitch"
                    android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/use_wallpaper"
                    android:textColor="@color/fl_editor_text" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/wallpaper_summary" android:textColor="@color/fl_editor_secondary" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/all_apps" android:textSize="18sp"
                android:textStyle="bold" android:textColor="@color/fl_editor_text" android:accessibilityHeading="true" />
            <EditText android:id="@+id/pickerSearch" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="12dp" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:background="@drawable/fl_editor_card" android:hint="@string/search_hint" android:inputType="text"
                android:imeOptions="actionDone" android:singleLine="true" android:textSize="15sp"
                android:textColor="@color/fl_editor_text" android:textColorHint="@color/fl_editor_secondary" />
            <TextView android:id="@+id/pickerStatus" android:layout_width="match_parent" android:layout_height="64dp"
                android:gravity="center" android:text="@string/loading_apps" android:textColor="@color/fl_editor_secondary" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/pickerAppsGrid" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/saveSelection"
        android:layout_width="match_parent" android:layout_height="60dp"
        android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginBottom="12dp"
        android:text="@string/save_selection" android:textAllCaps="false" android:textSize="16sp" android:enabled="false" />
</LinearLayout>
