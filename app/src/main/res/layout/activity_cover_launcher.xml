<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/coverRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@color/fl_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_widget_mark" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingStart="8dp" android:paddingEnd="0dp" android:text="@string/app_name"
            android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/coverEdit" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp"
            android:src="@drawable/ic_widget_add" android:contentDescription="@string/edit_on_phone" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/coverAppsGrid" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/coverEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="24dp" android:text="@string/widget_empty"
        android:textColor="@android:color/white" android:textSize="15sp" android:clickable="true" android:focusable="true" />
</LinearLayout>
