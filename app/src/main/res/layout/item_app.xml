<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="@dimen/fl_cover_icon_size"
        android:layout_height="@dimen/fl_cover_icon_size"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/appLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fl_icon_label_gap"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/fl_on_background"
        android:textSize="@dimen/fl_text_grid_label" />
</LinearLayout>
