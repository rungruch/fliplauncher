<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appShortcutPickerRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/fl_editor_background" android:focusableInTouchMode="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/choose_app_shortcuts" android:textSize="26sp" android:textStyle="bold"
                android:textColor="@color/fl_editor_text" android:accessibilityHeading="true" />
            <com.google.android.material.button.MaterialButton android:id="@+id/cancelShortcutPicker"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/cancel" android:textAllCaps="false" />
        </LinearLayout>
        <TextView android:id="@+id/shortcutPickerSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/fl_editor_secondary" />
        <TextView android:id="@+id/shortcutPickerCount" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="@color/fl_primary" />
        <EditText android:id="@+id/shortcutPickerSearch" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="12dp" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:background="@drawable/fl_editor_card" android:hint="@string/search_hint" android:inputType="text"
            android:imeOptions="actionDone" android:singleLine="true" android:textSize="15sp"
            android:textColor="@color/fl_editor_text" android:textColorHint="@color/fl_editor_secondary" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/shortcutPickerApps" android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:clipToPadding="false" />
        <TextView android:id="@+id/shortcutPickerStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:padding="32dp" android:text="@string/loading_apps"
            android:textColor="@color/fl_editor_secondary" android:textSize="14sp" />
    </FrameLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/saveAppShortcuts" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:layout_margin="16dp" android:text="@string/save_app_shortcuts" android:textAllCaps="false" />
</LinearLayout>
