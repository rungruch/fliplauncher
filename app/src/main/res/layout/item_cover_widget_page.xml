<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/coverWidgetContainer" android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:id="@+id/coverWidgetFallback" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="16dp">
            <TextView android:id="@+id/coverWidgetFallbackTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/fl_on_background" android:accessibilityHeading="true" />
            <TextView android:id="@+id/coverWidgetUnavailable" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center" android:text="@string/widget_unavailable_detail"
                android:textSize="14sp" android:textColor="@color/fl_gray_40" android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/openDashboardWidgetApp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/native_open" android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
