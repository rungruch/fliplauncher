<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="@drawable/fl_preview_wallpaper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_mark"
            android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingStart="8dp" android:paddingEnd="0dp" android:text="@string/app_name"
            android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold" />
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_add"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:padding="24dp" android:text="@string/widget_description"
        android:textColor="@android:color/white" android:textSize="18sp" />
</LinearLayout>
