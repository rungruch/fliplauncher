<?xml version="1.0" encoding="utf-8"?>
<!--
  FlipLauncher color tokens.
  Design language informed by One UI Home 18.0.07.59 (see analysis/design-tokens.md
  for provenance). Values re-expressed here as our own spec; no Samsung assets used.
-->
<resources>
    <!-- Gray ramp -->
    <color name="fl_gray_01">#FCFCFF</color>
    <color name="fl_gray_05">#F3F3F5</color>
    <color name="fl_gray_10">#E9E9EC</color>
    <color name="fl_gray_20">#CCCCCE</color>
    <color name="fl_gray_40">#A3A3A7</color>
    <color name="fl_gray_60">#636368</color>
    <color name="fl_gray_80">#3A3A3D</color>
    <color name="fl_gray_90">#252528</color>
    <color name="fl_gray_95">#17171A</color>
    <color name="fl_gray_100">#010102</color>

    <!-- Primary -->
    <color name="fl_primary">#387AFF</color>
    <color name="fl_primary_dark">#598FFF</color>

    <!-- Semantic roles (dark-first: cover screens are OLED) -->
    <color name="fl_background">@color/fl_gray_100</color>
    <color name="fl_surface">@color/fl_gray_95</color>
    <color name="fl_surface_container">@color/fl_gray_90</color>
    <color name="fl_on_background">@color/fl_gray_01</color>
    <color name="fl_on_surface_variant">@color/fl_gray_40</color>

    <!-- Native cover cards sit on the cover wallpaper: fl_surface at 80%. -->
    <color name="fl_native_card">#CC17171A</color>
    <color name="fl_wallpaper_text_shadow">#99000000</color>

    <!-- State overlays -->
    <color name="fl_pressed_overlay">#33FFFFFF</color>
    <color name="fl_selected_overlay">#1AFFFFFF</color>
    <color name="fl_editor_background">#F3F4F8</color>
    <color name="fl_editor_text">#17171A</color>
    <color name="fl_editor_secondary">#62666F</color>
</resources>
